{
  "name": "protovid-figma",
  "version": "1.3.14",
  "description": "Professional Prototype Video Exporter for Figma",
  "scripts": {
    "build": "node build.js",
    "test:matcher": "node --test test/smartAnimateMatcher.test.js",
    "test:ui-model": "node --test test/uiModel.test.js",
    "test": "npm run build && npm run test:matcher && npm run test:ui-model && node --test test/exportPreflight.test.js test/exportAnalytics.test.js",
    "watch": "node build.js --watch",
    "dev": "npm run watch"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.90.0",
    "@types/node": "^20.11.0",
    "chokidar": "^5.0.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "mp4-muxer": "^5.2.2",
    "preact": "^10.19.3",
    "vercel": "^58.9.2",
    "webm-muxer": "^5.1.4"
  }
}
