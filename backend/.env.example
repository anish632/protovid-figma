# Stripe Configuration
# Get these from your Stripe dashboard
STRIPE_SECRET_KEY=sk_test_your_test_secret_key_here_or_sk_live_for_production
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here
PROTOVID_STUDIO_MONTHLY_PRICE_ID=price_your_studio_monthly_stripe_price_id_here
PROTOVID_STUDIO_YEARLY_PRICE_ID=price_your_studio_yearly_stripe_price_id_here
PROTOVID_PROJECT_PASS_PRICE_ID=price_your_one_time_project_pass_price_id_here
# Legacy fallback for existing deployments. New environments should use the
# Studio-specific variables above.
PROTOVID_PRICE_ID=price_your_legacy_monthly_stripe_price_id_here

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Billing account management
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Strongly recommended: this keeps existing device tokens valid when Stripe keys rotate.
BILLING_MANAGEMENT_TOKEN_SECRET=your_32_byte_random_secret_here
# Required only for secure email links for customers who no longer have a
# completed Checkout session saved in the plugin.
RESEND_API_KEY=re_your_resend_api_key_here
BILLING_MANAGEMENT_EMAIL_FROM=ProtoVid <billing@example.com>
BILLING_SUPPORT_EMAIL=support@protovid.app
# Stripe-hosted portal login page. Customers enter their billing email and
# receive a secure sign-in link without contacting support.
STRIPE_CUSTOMER_PORTAL_LOGIN_URL=https://billing.stripe.com/p/login/your_portal_id

# Database Configuration
# Get this from your Neon/Postgres provider
NEON_DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# Stats API Key (generate a secure random string)
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STATS_API_KEY=your_secure_random_api_key_here

# Vercel Cron bearer secret for daily expired review-link deletion
CRON_SECRET=your_secure_random_cron_secret_here

# Free Export Limit (default: 1)
PROTOVID_FREE_EXPORT_LIMIT=1
PROTOVID_FREE_TIER_EXPERIMENT_ID=one_export_v1

# Security Configuration
NODE_ENV=development

# Dedicated ProtoVid portal configuration, also used for device-authorized sessions.
STRIPE_CUSTOMER_PORTAL_CONFIGURATION_ID=

# Stripe owns failed-payment and authentication reminders. Once the Resend sender
# above is verified, ProtoVid sends access deadline, pause, cancellation, and
# restoration notices. Missing sender configuration leaves notices pending.
