# Stripe Configuration
# Get these from your Stripe dashboard
STRIPE_SECRET_KEY=sk_test_your_test_secret_key_here_or_sk_live_for_production
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here
PROTOVID_PRICE_ID=price_your_monthly_stripe_price_id_here
PROTOVID_PROJECT_PASS_PRICE_ID=price_your_one_time_project_pass_price_id_here
PROTOVID_YEARLY_PRICE_ID=price_your_yearly_stripe_price_id_here

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Billing account management
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Strongly recommended: this keeps existing device tokens valid when Stripe keys rotate.
BILLING_MANAGEMENT_TOKEN_SECRET=your_32_byte_random_secret_here
# Required only for secure email links for customers who no longer have a
# completed Checkout session saved in the plugin.
RESEND_API_KEY=re_your_resend_api_key_here
BILLING_MANAGEMENT_EMAIL_FROM=ProtoVid <billing@example.com>
BILLING_SUPPORT_EMAIL=support@protovid.app

# Database Configuration
# Get this from your Neon/Postgres provider
NEON_DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# Stats API Key (generate a secure random string)
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STATS_API_KEY=your_secure_random_api_key_here

# Vercel Cron bearer secret for daily expired review-link deletion
CRON_SECRET=your_secure_random_cron_secret_here

# Free Export Limit (default: 3)
PROTOVID_FREE_EXPORT_LIMIT=3

# Security Configuration
NODE_ENV=development
